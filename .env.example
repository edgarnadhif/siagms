# PostgreSQL database used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct/session-mode database URL used by Prisma CLI commands and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a long random value and configure it only in the hosting environment.
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: required only for the AI insight feature.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
